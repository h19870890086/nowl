# Gateway 构建阶段
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app

# 复制 Maven 镜像配置（阿里云加速）
COPY settings.local.xml /root/.m2/settings.xml

# 复制全部源代码
COPY . .

# 直接构建网关模块
RUN mvn clean package -Dmaven.test.skip=true -pl unimarket-gateway -am -B

# Gateway 运行阶段
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

COPY --from=builder /app/unimarket-gateway/target/*.jar app.jar

RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

EXPOSE 8090

ENTRYPOINT ["java", "-jar", "-Xms256m", "-Xmx512m", "-Dfile.encoding=UTF-8", "app.jar"]
