services:
  # ==================== 中间件 ====================

  mysql:
    image: mysql:8.0
    container_name: nowl-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD:-nowl123456}
      MYSQL_DATABASE: nowl
      MYSQL_CHARACTER_SET_SERVER: utf8mb4
      MYSQL_COLLATION_SERVER: utf8mb4_unicode_ci
      TZ: Asia/Shanghai
    ports:
      - "${MYSQL_PORT:-3306}:3306"
    volumes:
      - ./data/mysql:/var/lib/mysql
      - ./sql/nowl_init.sql:/docker-entrypoint-initdb.d/01_init.sql:ro
    command: >
      --default-authentication-plugin=mysql_native_password
      --character-set-server=utf8mb4
      --collation-server=utf8mb4_unicode_ci
      --lower-case-table-names=1
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-p${DB_PASSWORD:-nowl123456}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      - nowl-net

  redis:
    image: redis:7-alpine
    container_name: nowl-redis
    restart: unless-stopped
    command: >
      redis-server
      --requirepass ${REDIS_PASSWORD:-nowl123456}
      --appendonly yes
    ports:
      - "${REDIS_PORT:-6379}:6379"
    volumes:
      - ./data/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:-nowl123456}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - nowl-net

  rocketmq-namesrv:
    image: apache/rocketmq:5.1.4
    container_name: nowl-rocketmq-namesrv
    restart: unless-stopped
    command: sh mqnamesrv
    environment:
      JAVA_OPT_EXT: "-server -Xms256m -Xmx256m"
    ports:
      - "9876:9876"
    networks:
      - nowl-net

  rocketmq-broker:
    image: apache/rocketmq:5.1.4
    container_name: nowl-rocketmq-broker
    restart: unless-stopped
    command: sh mqbroker -n rocketmq-namesrv:9876 -c /home/rocketmq/broker.conf
    environment:
      JAVA_OPT_EXT: "-server -Xms512m -Xmx512m"
    depends_on:
      - rocketmq-namesrv
    ports:
      - "10911:10911"
    volumes:
      - ./docker/rocketmq/broker.conf:/home/rocketmq/broker.conf:ro
    networks:
      - nowl-net

  elasticsearch:
    image: elasticsearch:8.13.0
    container_name: nowl-elasticsearch
    restart: unless-stopped
    environment:
      discovery.type: single-node
      ES_JAVA_OPTS: "-Xms512m -Xmx512m"
      xpack.security.enabled: "false"
      xpack.security.http.ssl.enabled: "false"
    ports:
      - "9200:9200"
    volumes:
      - ./data/elasticsearch:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9200/_cluster/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      - nowl-net

  # ==================== 后端服务 ====================

  nowl-backend:
    build:
      context: ./Nowl-backend
      dockerfile: Dockerfile
    container_name: nowl-backend
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
      rocketmq-broker:
        condition: service_started
      elasticsearch:
        condition: service_healthy
    environment:
      # 数据库
      DB_URL: jdbc:mysql://mysql:3306/nowl?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
      DB_USERNAME: ${DB_USERNAME:-root}
      DB_PASSWORD: ${DB_PASSWORD:-nowl123456}
      # Redis
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_DATABASE: ${REDIS_DATABASE:-0}
      REDIS_PASSWORD: ${REDIS_PASSWORD:-nowl123456}
      # JWT
      JWT_SECRET: ${JWT_SECRET:-ZGV2X2p3dF9zZWNyZXRfY2hhbmdlX21lX2Jhc2U2NA==}
      JWT_ACCESS_EXPIRATION: ${JWT_ACCESS_EXPIRATION:-60000000}
      JWT_REFRESH_EXPIRATION: ${JWT_REFRESH_EXPIRATION:-604800000}
      # AI（可选，不配置则 AI 对话功能不可用）
      OPENAI_API_KEY: ${OPENAI_API_KEY:-sk-placeholder}
      OPENAI_BASE_URL: ${OPENAI_BASE_URL:-https://api.moonshot.cn}
      OPENAI_MODEL: ${OPENAI_MODEL:-moonshot-v1-128k-vision-preview}
      # COS 对象存储（可选）
      COS_SECRET_ID: ${COS_SECRET_ID:-}
      COS_SECRET_KEY: ${COS_SECRET_KEY:-}
      COS_REGION: ${COS_REGION:-ap-guangzhou}
      COS_BUCKET_NAME: ${COS_BUCKET_NAME:-}
      COS_BASE_URL: ${COS_BASE_URL:-}
      # RocketMQ
      ROCKETMQ_NAME_SERVER: rocketmq-namesrv:9876
      ROCKETMQ_PRODUCER_GROUP: ${ROCKETMQ_PRODUCER_GROUP:-nowl-producer-group}
      # Elasticsearch
      ES_HOST: elasticsearch:9200
      ES_USERNAME: ${ES_USERNAME:-}
      ES_PASSWORD: ${ES_PASSWORD:-}
      # XXL-JOB（可选）
      XXL_JOB_ADMIN_ADDRESSES: ${XXL_JOB_ADMIN_ADDRESSES:-}
      XXL_JOB_ACCESS_TOKEN: ${XXL_JOB_ACCESS_TOKEN:-default_token}
      XXL_EXECUTOR_APPNAME: ${XXL_EXECUTOR_APPNAME:-nowl-executor}
      XXL_EXECUTOR_PORT: ${XXL_EXECUTOR_PORT:-9999}
      # 短信（可选，已被邮件替代）
      SMS_SPUG_URL: ${SMS_SPUG_URL:-}
      SMS_ENABLED: ${SMS_ENABLED:-false}
      # 邮件验证码（QQ邮箱SMTP）
      MAIL_ENABLED: ${MAIL_ENABLED:-false}
      SPRING_MAIL_HOST: ${MAIL_HOST:-smtp.qq.com}
      SPRING_MAIL_PORT: ${MAIL_PORT:-587}
      SPRING_MAIL_USERNAME: ${MAIL_USERNAME:-}
      SPRING_MAIL_PASSWORD: ${MAIL_PASSWORD:-}
      SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH: "true"
      SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE: "true"
      # 其他
      DEFAULT_AVATAR: ${DEFAULT_AVATAR:-}
      UPLOAD_PATH: /app/uploads
      SERVER_PORT: 8080
    ports:
      - "8080:8080"
    volumes:
      - ./data/uploads:/app/uploads
    networks:
      - nowl-net

  nowl-gateway:
    build:
      context: ./Nowl-backend
      dockerfile: Dockerfile.gateway
    container_name: nowl-gateway
    restart: unless-stopped
    depends_on:
      - nowl-backend
      - redis
    environment:
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_DATABASE: ${REDIS_DATABASE:-0}
      REDIS_PASSWORD: ${REDIS_PASSWORD:-nowl123456}
      # 网关路由目标
      UM_BACKEND_URI: http://nowl-backend:8080
      UM_BACKEND_WS_URI: ws://nowl-backend:8080
      # CORS 允许的前端来源
      UM_CORS_ALLOWED_ORIGIN_PATTERN_1: ${UM_CORS_ALLOWED_ORIGIN_PATTERN_1:-http://localhost:*}
      UM_CORS_ALLOWED_ORIGIN_PATTERN_2: ${UM_CORS_ALLOWED_ORIGIN_PATTERN_2:-http://127.0.0.1:*}
    ports:
      - "8090:8090"
    networks:
      - nowl-net

  # ==================== 前端 ====================

  nowl-front:
    build:
      context: ./Nowl-front
      dockerfile: Dockerfile
    container_name: nowl-front
    restart: unless-stopped
    depends_on:
      - nowl-gateway
    ports:
      - "${FRONTEND_PORT:-3000}:80"
    networks:
      - nowl-net


# ==================== 网络 ====================
networks:
  nowl-net:
    name: nowl-net
    driver: bridge
